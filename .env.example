# BluePlayer - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ==============================================================================
# REQUIRED - Twitch Application Credentials
# ==============================================================================
# Get these from https://dev.twitch.tv/console/apps
# 1. Create a new application (or use existing)
# 2. Set OAuth Redirect URL to: https://127.0.0.1:8443/callback
# 3. Copy Client ID and generate a Client Secret

TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# ==============================================================================
# OPTIONAL - TLS Certificates for OAuth
# ==============================================================================
# Default paths are certs/twitch-cert.pem and certs/twitch-key.pem
# Only set these if you use custom paths

# TWITCH_TLS_CERT_PATH=certs/twitch-cert.pem
# TWITCH_TLS_KEY_PATH=certs/twitch-key.pem

# ==============================================================================
# OPTIONAL - OAuth Redirect Configuration
# ==============================================================================
# Default: https://localhost:3000/callback

# TWITCH_REDIRECT_URI=https://127.0.0.1:8443/callback
# TWITCH_REDIRECT_PORT=8443

# ==============================================================================
# DEVELOPMENT/TESTING ONLY
# ==============================================================================
# These are only used for E2E tests and development

# BLUEPLAYER_API_URL=http://localhost:8080
# BLUEPLAYER_IRC_URL=ws://localhost:6667
# BLUEPLAYER_HLS_PROXY_URL=http://localhost:8081
# E2E_FIXTURES_PATH=/path/to/fixtures
